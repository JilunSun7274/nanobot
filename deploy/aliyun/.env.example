# Nanobot 环境变量
# 使用方式：cp .env.example .env && chmod 600 .env && vim .env
# 警告：.env 文件含有敏感密钥，已加入 .gitignore，切勿提交！

# ── 服务器信息 ─────────────────────────────────────────────────────
SERVER_PUBLIC_IP=替换为你的公网IP
SERVER_PRIVATE_IP=替换为你的内网IP

# ── 阿里云 ACR（CI/CD 用，暂时可跳过） ────────────────────────────
# 镜像仓库地址，格式：registry.cn-hongkong.aliyuncs.com/你的命名空间
ACR_REGISTRY=registry.cn-hongkong.aliyuncs.com/替换为你的命名空间
ACR_USERNAME=替换为你的阿里云账号
ACR_PASSWORD=替换为你的ACR密码

# ── LLM Provider（至少配置一个） ───────────────────────────────────
# 步骤：
#   1. 取消注释你要用的 provider 的 API_KEY 行并填入密钥
#   2. 在 config.json 中同步修改：
#      - "providers" 里添加对应条目，如 "deepseek": {"apiKey": "${DEEPSEEK_API_KEY}"}
#      - "agents.defaults.provider" 改为你的 provider 名
#      - "agents.defaults.model" 改为该 provider 支持的模型
# 可同时配置多个 provider。完整列表见 nanobot 文档：docs/configuration.md

# --- 网关型（路由任意模型）---
# OpenRouter   https://openrouter.ai/keys
#OPENROUTER_API_KEY=sk-or-v1-替换为你的key
# AiHubMix     https://aihubmix.com
#AIHUBMIX_API_KEY=替换为你的key
# 硅基流动     https://cloud.siliconflow.cn
#SILICONFLOW_API_KEY=替换为你的key

# --- 直连型 ---
# Anthropic    https://console.anthropic.com
#ANTHROPIC_API_KEY=sk-ant-替换为你的key
# OpenAI       https://platform.openai.com/api-keys
#OPENAI_API_KEY=sk-替换为你的key
# DeepSeek     https://platform.deepseek.com
#DEEPSEEK_API_KEY=替换为你的key
# Google Gemini https://aistudio.google.com/apikey
#GEMINI_API_KEY=替换为你的key
# Mistral      https://console.mistral.ai
#MISTRAL_API_KEY=替换为你的key
# Groq         https://console.groq.com/keys
#GROQ_API_KEY=替换为你的key

# --- 国内直连 ---
# 通义千问(DashScope) https://dashscope.console.aliyun.com
#DASHSCOPE_API_KEY=替换为你的key
# 智谱(GLM)    https://open.bigmodel.cn
#ZHIPU_API_KEY=替换为你的key
# 月之暗面(Kimi) https://platform.moonshot.cn
#MOONSHOT_API_KEY=替换为你的key
# MiniMax      https://platform.minimaxi.com
#MINIMAX_API_KEY=替换为你的key
# 火山引擎     https://console.volcengine.com
#VOLCENGINE_API_KEY=替换为你的key
# 百度千帆     https://qianfan.cloud.baidu.com
#QIANFAN_API_KEY=替换为你的key
# 阶跃星辰     https://platform.stepfun.com
#STEPFUN_API_KEY=替换为你的key

# ── 飞书（选填，不启用则留空） ─────────────────────────────────────
# 创建应用：https://open.feishu.cn/app
FEISHU_APP_ID=cli_替换为你的AppId
FEISHU_APP_SECRET=替换为你的AppSecret

# ── 钉钉（选填，不启用则留空） ─────────────────────────────────────
# 创建应用：https://open.dingtalk.com/
DINGTALK_CLIENT_ID=替换为你的ClientId
DINGTALK_CLIENT_SECRET=替换为你的ClientSecret
